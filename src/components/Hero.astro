---
import QuoteForm from './QuoteForm.astro';
---

<section class="hero-section" id="quote">
  <div class="container">
    <div class="hero-grid">
      
      <!-- Left: Hero Text Content -->
      <div class="hero-content">
        <span class="hero-tag">Landscaping, Patios, Structures & More in Marysville, WA</span>
        <h1 class="hero-title">Expert Landscapers In Marysville, WA</h1>
        <p class="hero-desc">
          Whether you need routine maintenance or a complete landscape overhaul, Got Yard Landscaping and Construction has a dedicated crew ready for heavy-duty work and turning outdoor spaces into dream yards.
        </p>
        
        <div class="hero-trust-bar">
          <a href="tel:4256961427" class="hero-phone-btn">Click To Call (425) 696-1427</a>
          <div class="rating-badge">
            <span class="rating-stars">★★★★★</span>
            <span class="rating-text">Google <strong>5.0 Star Rating</strong></span>
          </div>
        </div>
      </div>

      <!-- Right: Modular Quote Request Form Component -->
      <QuoteForm />

    </div>
  </div>
</section>
