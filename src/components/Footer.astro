<footer class="site-footer">
  <div class="container">
    
    <!-- Top Row: Centered Brand Logo & Tagline -->
    <div class="footer-brand-row">
      <a href="/" class="footer-logo-link">
        <img src="/assets/logo-light.webp" alt="Got Yard? Landscape Construction Logo" class="footer-logo" />
      </a>
      <p class="footer-tagline">
        Licensed & Insured Landscape Construction, Patios, Decks & Excavation serving Marysville, Arlington, Everett & Snohomish County.
      </p>
    </div>

    <!-- Middle Row: Clean Navigation Links & Action Button -->
    <div class="footer-nav-row">
      <a href="/" class="footer-link">Home</a>
      <a href="/service-areas/arlington-wa" class="footer-link">Arlington, WA</a>
      <a href="/gallery" class="footer-link">Project Gallery</a>
      <a href="tel:4256961427" class="footer-phone-link">Click To Call (425) 696-1427</a>
      <button type="button" class="btn btn-gold footer-cta-btn js-open-quote-modal">Request Free Quote</button>
    </div>

    <!-- Bottom Row: Copyright & Legal Bar -->
    <div class="footer-bottom-bar">
      <p class="footer-copy">
        © 2026 Got Yard? Landscape Construction. All rights reserved. | Built with pride in Snohomish County, WA.
      </p>
    </div>

  </div>
</footer>

<style>
.site-footer {
  background-color: #0b0d0c;
  padding: 60px 0 32px 0;
  border-top: 2px solid #000000;
}

.footer-brand-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 32px;
}

.footer-logo-link {
  display: inline-block;
  margin-bottom: 14px;
}

.footer-logo {
  height: 64px;
  width: auto;
  margin: 0 auto;
  display: block;
}

.footer-tagline {
  font-size: 0.95rem;
  color: #a0ac9e;
  max-width: 580px;
  line-height: 1.6;
  margin: 0 auto;
}

.footer-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  flex-wrap: wrap;
  padding-bottom: 32px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 24px;
}

.footer-link {
  font-size: 0.95rem;
  font-weight: 600;
  color: #ffffff;
  transition: color 0.15s ease;
}

.footer-link:hover {
  color: #89e44d;
}

.footer-phone-link {
  font-size: 0.95rem;
  font-weight: 700;
  color: #e5a93c;
  transition: color 0.15s ease;
}

.footer-phone-link:hover {
  color: #f0be53;
}

.footer-cta-btn {
  padding: 8px 18px;
  font-size: 0.88rem;
}

.footer-bottom-bar {
  text-align: center;
}

.footer-copy {
  font-size: 0.85rem;
  color: #606b63;
}

@media (max-width: 640px) {
  .footer-nav-row {
    flex-direction: column;
    gap: 16px;
  }
}
</style>
