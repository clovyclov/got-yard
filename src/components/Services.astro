---
const services = [
  {
    title: "Hardscaping & Paver Patios",
    subtitle: "Custom Patios, Walkways & Outdoor Fire Pits",
    image: "/assets/paver-patio-construction.webp",
    link: "/services/hardscaping"
  },
  {
    title: "Landscaping & Sod Installation",
    subtitle: "Premium Sod Lawns, Overhauls & Bark Beds",
    image: "/assets/sod-installation-lawn.webp",
    link: "/services/landscaping"
  },
  {
    title: "Deck Building & Structures",
    subtitle: "Trex Composite Decks, Covered Patio Roofs & Pergolas",
    image: "/assets/composite-deck-building.webp",
    link: "/services/decks"
  },
  {
    title: "Pressure Washing & Cleaning",
    subtitle: "Driveways, Patios, Sidewalks & Exterior Soft Wash",
    image: "/assets/pressure-washing-driveway.webp",
    link: "/services/pressure-washing"
  },
  {
    title: "Irrigation & Sprinklers",
    subtitle: "Multi-Zone Sprinklers, Drip Lines & Smart Controllers",
    image: "/assets/sprinkler-irrigation-lawn.webp",
    link: "/services/irrigation-system-installation"
  },
  {
    title: "3D Landscape Design",
    subtitle: "3D Master Renderings, Plant Palettes & Lighting",
    image: "/assets/3d-landscape-design-plan.webp",
    link: "/services/landscape-design"
  }
];
---

<section class="services-section" id="services">
  <div class="container">
    <div class="services-header-center">
      <span class="section-eyebrow">Yard Services You Can Depend On</span>
      <h2 class="section-title">Our Specialized Services</h2>
      <p class="section-desc">Click any service below to explore project galleries, sub-services, FAQs, and request a free quote!</p>
    </div>

    <div class="services-grid">
      {services.map(item => (
        <a href={item.link} class="service-card-link">
          <div class="service-card">
            <img src={item.image} alt={item.title} class="service-card-img" loading="lazy" />
            <div class="service-card-overlay">
              <h3 class="service-card-title">{item.title}</h3>
              <p class="service-card-sub">{item.subtitle}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.services-section {
  padding: 90px 0;
  background-color: var(--clr-bg-dark);
}

.services-header-center {
  text-align: center;
  margin-bottom: 48px;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.service-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  width: 100%;
}

.service-card {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  border: 2.5px solid #000000;
  box-shadow: 4px 6px 0px 0px #000000;
  aspect-ratio: 4/3;
  transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease;
  background-color: var(--clr-bg-card);
  width: 100%;
}

.service-card-link:hover .service-card {
  transform: translateY(-6px);
  box-shadow: 8px 12px 0px 0px #000000;
}

.service-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* NO scale zoom on hover */
}

.service-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(10, 14, 11, 0.94) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  text-align: center;
  padding: 24px 20px;
  transition: background 0.3s ease;
}

.service-card-link:hover .service-card-overlay {
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(10, 14, 11, 0.98) 100%);
}

.service-card-badge {
  display: inline-block;
  align-self: center;
  background: #ffffff;
  color: #000000;
  font-size: 0.82rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  padding: 6px 14px;
  border-radius: 6px;
  border: 2px solid #000000;
  box-shadow: 2px 3px 0px 0px #000000;
  margin-bottom: 10px;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.service-card-link:hover .service-card-badge {
  background: var(--clr-accent-gold, #e5a93c);
  color: #000000;
  transform: scale(1.04);
}

.service-card-title {
  font-family: var(--font-heading);
  font-size: 1.55rem;
  font-weight: 700;
  line-height: 1.15;
  text-transform: uppercase;
  color: #ffffff;
  margin: 0 0 6px 0;
  letter-spacing: 0.5px;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.7);
  text-align: center;
  width: 100%;
}

.service-card-sub {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
  line-height: 1.35;
  text-align: center;
  width: 100%;
}

@media (max-width: 992px) {
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .services-grid {
    grid-template-columns: 1fr;
  }

  .service-card-title {
    font-size: 1.35rem;
  }
}
</style>
