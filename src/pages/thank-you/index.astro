---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const videoUrl = "https://vz-1ca5031c-4d7.b-cdn.net/1a00a53b-fd96-4a3c-89f1-b00f036ee02a/play_720p.mp4";
---

<Layout 
  title="Thank You! | Got Yard? Landscape Construction"
  description="Thank you for requesting a free quote with Got Yard? Watch our quick next steps video to see what happens next."
>
  <Header />

  <main class="thank-you-page">
    <section class="thank-you-hero">
      <div class="container">
        
        <div class="thank-you-badge">QUOTE REQUEST RECEIVED</div>
        
        <h1 class="thank-you-title">Thank You! We Received Your Project Request</h1>
        
        <p class="thank-you-subtitle">
          Watch the short video below to see exactly what happens next and how we prepare your custom landscape or hardscape estimate.
        </p>

        <!-- Video Player Section -->
        <div class="video-container-card">
          <div class="video-wrapper">
            <video 
              id="nextStepsVideo" 
              controls 
              playsinline
              preload="metadata"
              poster="/assets/rylan-next-steps-thumbnail.webp"
            >
              <source src={videoUrl} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>

        <!-- Next Steps Timeline -->
        <div class="next-steps-section">
          <h2 class="next-steps-heading">What Happens Next?</h2>
          
          <div class="next-steps-grid">
            <div class="step-card">
              <div class="step-num">01</div>
              <h3 class="step-title">Project & Site Review</h3>
              <p class="step-desc">Rylan and our team review your submitted project details, address, and scope within 2 to 4 business hours.</p>
            </div>

            <div class="step-card">
              <div class="step-num">02</div>
              <h3 class="step-title">On-Site Consultation</h3>
              <p class="step-desc">We call or text you to schedule a quick on-site consultation to measure your yard, assess drainage, and discuss material samples.</p>
            </div>

            <div class="step-card">
              <div class="step-num">03</div>
              <h3 class="step-title">Itemized Proposal</h3>
              <p class="step-desc">You receive a clear, transparent estimate with itemized pricing, project timelines, and estimated start dates.</p>
            </div>
          </div>
        </div>

        <!-- Direct CTA Action Bar -->
        <div class="thank-you-actions">
          <div class="urgent-box">
            <span class="urgent-text">Need immediate help or want to speak with Rylan right away?</span>
            <a href="tel:4256961427" class="btn btn-primary btn-lg">Click To Call (425) 696-1427</a>
          </div>

          <a href="/" class="btn btn-outline margin-top-sm">← Back To Homepage</a>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.thank-you-page {
  background-color: var(--clr-bg-dark);
  min-height: 80vh;
  padding: 140px 0 100px 0;
  text-align: center;
}

.thank-you-hero {
  max-width: 960px;
  margin: 0 auto;
}

.thank-you-badge {
  display: inline-block;
  background: #89e44d;
  border: 2px solid #000000;
  box-shadow: 3px 3px 0px 0px #000000;
  color: #000000;
  padding: 6px 18px;
  font-size: 0.9rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 24px;
}

.thank-you-title {
  font-family: var(--font-heading);
  font-size: 3.2rem;
  color: #ffffff;
  text-transform: uppercase;
  line-height: 1.1;
  margin-bottom: 18px;
}

.thank-you-subtitle {
  font-size: 1.2rem;
  color: var(--clr-text-muted);
  max-width: 760px;
  margin: 0 auto 40px auto;
  line-height: 1.6;
}

/* Video Player Card */
.video-container-card {
  background: #101311;
  border: 3px solid #000000;
  box-shadow: 8px 10px 0px 0px #000000;
  border-radius: var(--radius-md);
  padding: 12px;
  margin-bottom: 64px;
  overflow: hidden;
}

.video-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%; /* 16:9 Aspect Ratio */
  background: #000000;
  border-radius: 4px;
  overflow: hidden;
}

.video-wrapper video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Next Steps 3-Card Grid */
.next-steps-section {
  margin-bottom: 60px;
}

.next-steps-heading {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  color: #ffffff;
  text-transform: uppercase;
  margin-bottom: 36px;
}

.next-steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.step-card {
  background: var(--clr-bg-card);
  border: 2px solid #000000;
  box-shadow: 4px 6px 0px 0px #000000;
  padding: 32px 24px;
  text-align: left;
  position: relative;
}

.step-num {
  font-family: var(--font-heading);
  font-size: 2.4rem;
  font-weight: 900;
  color: #89e44d;
  line-height: 1;
  margin-bottom: 12px;
}

.step-title {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  color: #ffffff;
  margin-bottom: 10px;
}

.step-desc {
  font-size: 0.95rem;
  color: var(--clr-text-muted);
  line-height: 1.6;
}

/* Direct Action Bar */
.thank-you-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.urgent-box {
  background: #181d1a;
  border: 2px solid #000000;
  box-shadow: 4px 5px 0px 0px #000000;
  padding: 24px 32px;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.urgent-text {
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
}

.btn-outline {
  background: transparent;
  border: 2px solid #ffffff;
  color: #ffffff;
  padding: 12px 24px;
  font-weight: 700;
  transition: all 0.2s ease;
}

.btn-outline:hover {
  background: #ffffff;
  color: #000000;
}

@media (max-width: 992px) {
  .next-steps-grid {
    grid-template-columns: 1fr;
  }
  
  .thank-you-title {
    font-size: 2.4rem;
  }
}
</style>
