---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Reviews from '../../components/Reviews.astro';
import Footer from '../../components/Footer.astro';

const projects = [
  { category: "hardscaping", image: "/assets/3109C95B-6E8B-4255-9C4A-04ECA2D9E075.webp", alt: "Custom Paver Patio & Outdoor Living Space" },
  { category: "decks", image: "/assets/623CF190-7319-4F5A-9E58-AC06F10AD535.webp", alt: "Composite Deck Building & Custom Railing" },
  { category: "hardscaping", image: "/assets/35404C40-991F-444A-85E2-0CFC8F9484AF.webp", alt: "Terraced Retaining Wall & Slope Terracing" },
  { category: "landscaping", image: "/assets/IMG_1338.webp", alt: "Yard Drainage & Fresh Sod Replacement" },
  { category: "hardscaping", image: "/assets/E91E8AA7-31CF-49BC-8AC9-25CBCDBEC608.webp", alt: "Outdoor Fireplace & Paver Patio Surround" },
  { category: "decks", image: "/assets/C8804C51-CDF0-4FB9-968E-28B306356A79.webp", alt: "Multi-Tier Lakeview Deck Construction" },
  { category: "hardscaping", image: "/assets/5846597F-A577-4BAF-AC83-E61DD2763FD0.webp", alt: "Block Retaining Wall & Drainage System" },
  { category: "decks", image: "/assets/E02C06A6-230C-4116-9F1A-E4EDFE93481A.webp", alt: "Custom Outdoor Deck & Covered Porch" },
  { category: "hardscaping", image: "/assets/8E068ADE-A26A-424E-ABE5-EB3C09EB6B93.webp", alt: "Modern Paver Patio Living Space" },
  { category: "landscaping", image: "/assets/D49B4CEC-4EBC-4B2F-B533-6B29FD3B6DC3.webp", alt: "Excavation and Slope Grading" },
  { category: "hardscaping", image: "/assets/IMG_1562.webp", alt: "Acreage Drainage and Retaining Wall" },
  { category: "landscaping", image: "/assets/3DE8DB3E-C6D8-488B-BE38-BD55FF056CC2.webp", alt: "French Drain and Lawn Installation" },
  { category: "hardscaping", image: "/assets/064FCB37-6A31-4338-97E8-F803E3024ACB.webp", alt: "Stone Retaining Wall Installation" },
  { category: "decks", image: "/assets/5F482040-42FE-4F69-9979-AD0F8A1BD915.webp", alt: "Timber Decking & Staircase Build" },
  { category: "hardscaping", image: "/assets/93F966D3-8BF6-411F-924D-4B634A70F99C.webp", alt: "Flagstone Walkway Paving" },
  { category: "landscaping", image: "/assets/9ED8FAFA-0114-4AF7-AF14-FECEC09DE813.webp", alt: "Heavy Yard Grading & Site Prep" },
  { category: "hardscaping", image: "/assets/D84A26FA-5B23-4FBC-B4AC-5475AAA42050.webp", alt: "Commercial Concrete Paver Patio" },
  { category: "landscaping", image: "/assets/IMG_0677.webp", alt: "Residential Yard Overhaul" },
  { category: "hardscaping", image: "/assets/IMG_0910.webp", alt: "Paver Seating Wall & Fire Pit" },
  { category: "decks", image: "/assets/IMG_0911.webp", alt: "Covered Composite Deck Porch" },
  { category: "hardscaping", image: "/assets/IMG_0912.webp", alt: "Retaining Wall Terraced Garden" },
  { category: "landscaping", image: "/assets/IMG_0915.webp", alt: "Lawn Replacement & Sod Prep" },
  { category: "hardscaping", image: "/assets/IMG_1049.webp", alt: "Interlocking Paver Driveway" },
  { category: "landscaping", image: "/assets/IMG_1340.webp", alt: "Subsurface French Drain System" },
  { category: "hardscaping", image: "/assets/IMG_1346.webp", alt: "Outdoor Kitchen & BBQ Base" },
  { category: "decks", image: "/assets/IMG_1569.webp", alt: "Custom Staircase & Aluminum Railing" },
  { category: "hardscaping", image: "/assets/IMG_5503.webp", alt: "Natural Basalt Boulder Retaining Wall" },
  { category: "landscaping", image: "/assets/IMG_8026.webp", alt: "Land Clearing & Brush Excavation" },
  { category: "hardscaping", image: "/assets/IMG_8030.webp", alt: "Custom Patio Fire Pit Table" },
  { category: "decks", image: "/assets/IMG_8032.webp", alt: "Multi-Level Outdoor Living Deck" },
  { category: "hardscaping", image: "/assets/IMG_8061.webp", alt: "Paved Entryway & Pathway" }
];

// Schema.org ImageGallery JSON-LD
const imageGallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Got Yard Landscape & Construction Project Gallery",
  "description": "Photo gallery of recent hardscaping, paver patios, composite decks, retaining walls, and custom landscaping across Snohomish County.",
  "url": "https://gotyardlandscape.com/gallery",
  "image": projects.map(p => `https://gotyardlandscape.com${p.image}`)
};
---

<Layout
  title="Landscape & Hardscaping Project Gallery | Got Yard?"
  description="Explore photos of recent paver patios, composite decks, retaining walls, sod, and custom yard transformations built by Got Yard across Snohomish County."
>
  <script type="application/ld+json" set:html={JSON.stringify(imageGallerySchema)} />

  <Header />

  <!-- Hero Banner -->
  <section class="gallery-hero">
    <div class="container">
      <span class="gallery-eyebrow">Proven Quality Craftsmanship</span>
      <h1 class="gallery-h1">Project Gallery</h1>
      <p class="gallery-sub">
        Explore real landscape transformations, custom deck builds, paver patios, and retaining walls built by Got Yard across Marysville, Arlington, Everett & Snohomish County.
      </p>

      <div class="gallery-hero-actions">
        <button type="button" class="btn btn-primary js-open-quote-modal">Start Your Project</button>
        <a href="tel:4256961427" class="btn btn-gold">Click To Call (425) 696-1427</a>
      </div>
    </div>
  </section>

  <!-- Clean Photo Gallery Section -->
  <section class="gallery-main-section">
    <div class="container">
      
      <!-- Clean Seamless Photo Grid -->
      <div class="gallery-grid" id="galleryGrid">
        {projects.map(item => (
          <div class="gallery-item" data-src={item.image}>
            <img src={item.image} alt={item.alt} loading="lazy" />
            <div class="gallery-item-overlay">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#e5a93c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Client Reviews Strip -->
  <Reviews />

  <!-- Bottom CTA Banner -->
  <section class="gallery-bottom-cta">
    <div class="container">
      <div class="cta-banner-card">
        <h2 class="cta-title">Ready To Transform Your Property?</h2>
        <p class="cta-desc">Contact Got Yard today for a free on-site consultation and quote. We turn your outdoor space into the yard of your dreams.</p>
        <div class="cta-btn-wrap">
          <button type="button" class="btn btn-gold js-open-quote-modal">Request A Free Quote</button>
          <a href="tel:4256961427" class="btn btn-primary">Click To Call (425) 696-1427</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Lightbox Modal -->
  <div class="gallery-lightbox" id="galleryLightbox">
    <span class="lightbox-close-btn" id="closeLightbox">&times;</span>
    <div class="lightbox-content-box">
      <img src="" alt="Enlarged Project View" id="lightboxActiveImg" class="lightbox-active-img" />
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Lightbox Modal Logic
    const lightbox = document.getElementById('galleryLightbox');
    const lightboxImg = document.getElementById('lightboxActiveImg') as HTMLImageElement;
    const closeBtn = document.getElementById('closeLightbox');
    const items = document.querySelectorAll('.gallery-item');

    items.forEach(item => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-src');

        if (lightbox && lightboxImg && src) {
          lightboxImg.src = src;
          lightbox.classList.add('active');
        }
      });
    });

    if (closeBtn && lightbox) {
      closeBtn.addEventListener('click', () => {
        lightbox.classList.remove('active');
      });
    }

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          lightbox.classList.remove('active');
        }
      });
    }
  });
</script>

<style>
/* Hero Banner */
.gallery-hero {
  padding-top: 150px;
  padding-bottom: 70px;
  background: linear-gradient(180deg, rgba(16, 19, 17, 0.85) 0%, rgba(16, 19, 17, 0.98) 100%),
              url('/assets/hero-bg.webp') center/cover no-repeat;
  border-bottom: 1px solid var(--clr-border);
  text-align: center;
}

.gallery-eyebrow {
  display: inline-block;
  background: #89e44d;
  border: 2px solid #000000;
  box-shadow: 3px 4px 0px 0px #000000;
  color: #000000;
  padding: 6px 16px;
  font-size: 0.88rem;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.gallery-h1 {
  font-family: var(--font-heading);
  font-size: 3.8rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--clr-text-main);
  letter-spacing: 1.5px;
  margin-bottom: 16px;
}

@media (max-width: 768px) {
  .gallery-h1 {
    font-size: 2.6rem;
  }
}

.gallery-sub {
  font-size: 1.15rem;
  color: var(--clr-text-muted);
  max-width: 800px;
  margin: 0 auto 32px auto;
  line-height: 1.7;
}

.gallery-hero-actions {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

/* Photo Gallery Section */
.gallery-main-section {
  padding: 80px 0;
  background-color: var(--clr-bg-dark);
}

/* Bottom CTA Banner */
.gallery-bottom-cta {
  padding: 80px 0;
  background: var(--clr-bg-surface);
  border-top: 1px solid var(--clr-border);
}

.cta-banner-card {
  background: linear-gradient(135deg, #1e3a1a 0%, #10240e 100%);
  border: 3px solid #000000;
  box-shadow: 6px 8px 0px 0px #000000;
  padding: 56px 40px;
  border-radius: var(--radius-md);
  text-align: center;
  max-width: 960px;
  margin: 0 auto;
}

.cta-title {
  font-family: var(--font-heading);
  font-size: 2.8rem;
  color: #ffffff;
  margin-bottom: 16px;
  text-transform: uppercase;
}

.cta-desc {
  font-size: 1.1rem;
  color: #c0d4be;
  max-width: 700px;
  margin: 0 auto 32px auto;
  line-height: 1.6;
}

.cta-btn-wrap {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

/* Lightbox Modal */
.gallery-lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(10px);
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.gallery-lightbox.active {
  display: flex;
}

.lightbox-content-box {
  position: relative;
  max-width: 90vw;
  width: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin: 0 auto;
}

.lightbox-close-btn {
  position: fixed;
  top: 20px;
  right: 28px;
  color: #ffffff;
  font-size: 3rem;
  font-weight: 700;
  cursor: pointer;
  z-index: 10000;
  line-height: 1;
  transition: transform 0.15s ease;
}

.lightbox-close-btn:hover {
  transform: scale(1.2);
  color: #89e44d;
}

.lightbox-active-img {
  max-width: 90vw;
  max-height: 85vh;
  width: auto;
  height: auto;
  border: 3px solid #000000;
  box-shadow: 6px 8px 0px 0px #000000;
  object-fit: contain;
  margin: 0 auto;
  display: block;
}
</style>
